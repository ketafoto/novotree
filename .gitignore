__pycache__
venv-linux
venv-win
.venv
node_modules
/test_gedcom.db

# Root-level sqlite files (created during dev/testing)
*.sqlite

# All owner data is runtime — never commit databases or media.
# Only .gitkeep placeholder files are tracked to preserve directory structure.
datasets/*
!datasets/.gitkeep

# Local-installer build artifacts — generated by installer/build.ps1.
# Everything is consolidated under installer/ so the repo root stays clean,
# but we also gitignore /dist/ and /build/ at the root in case someone runs
# pyinstaller without the --workpath / --distpath flags from build.ps1.
/installer/build/
/installer/dist/
/installer/Output/
/installer/version.iss
/installer/version_info.txt
/dist/
/build/
