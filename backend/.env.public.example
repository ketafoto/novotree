# Example environment file for production deployment.
# The app does not auto-load this file by name; copy values into your actual
# environment source (systemd EnvironmentFile, container env vars, etc.).

# ── App mode ────────────────────────────────────────────────────────────────
# "admin" = local dev bypass (no login required, all endpoints open).
# Any other value (e.g. "public") enables full JWT auth.
NOVOTREE_APP_MODE=public

# Set to false only when testing public mode over plain HTTP (e.g. local VM).
# In production, leave unset — defaults to true so cookies require HTTPS.
# COOKIE_SECURE=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated, no spaces unless part of URL.
CORS_ORIGINS=https://novotree.cz,https://www.novotree.cz,https://novospace.cz/novotree,https://www.novospace.cz/novotree

# ── API docs ─────────────────────────────────────────────────────────────────
# Disable Swagger/ReDoc in production.
ENABLE_API_DOCS=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120

# ── JWT (REQUIRED in production) ─────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-hex-char-string

# Token lifetime in hours (default 8).  Access token is refreshed silently via
# a refresh cookie; users are only logged out when the refresh token expires.
JWT_EXPIRY_HOURS=8

# Refresh token lifetime in days (default 14).
JWT_REFRESH_DAYS=14

# ── Support contact (optional) ───────────────────────────────────────────────
# Shown on auth pages as "Having trouble? Contact the administrator".
# Leave unset to hide the link entirely.
# When SMTP is not configured, account registration is disabled and this address
# is shown so users know how to request an account.
ADMIN_EMAIL=admin@novotree.cz

# ── SMTP (optional) ──────────────────────────────────────────────────────────
# If not configured, contributor set-password links are shown in the UI instead
# of being emailed.  All fields must be set to enable email.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# SMTP_USER is literally "resend" for all Resend.com accounts; auth is via the API key in SMTP_PASSWORD
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=NovoTree <noreply@contact.novotree.cz>
