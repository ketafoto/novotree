# Example environment file for production deployment.
# The app does not auto-load this file by name; copy values into your actual
# environment source (systemd EnvironmentFile, container env vars, etc.).

# ── App mode ────────────────────────────────────────────────────────────────
# "admin" = local dev bypass (no login required, all endpoints open).
# Any other value (e.g. "public") enables full JWT auth.
NOVOTREE_APP_MODE=public

# Set to false only when testing public mode over plain HTTP (e.g. local VM).
# In production, leave unset — defaults to true so cookies require HTTPS.
# COOKIE_SECURE=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated, no spaces unless part of URL.
CORS_ORIGINS=https://novotree.cz,https://www.novotree.cz,https://novospace.cz/novotree,https://www.novospace.cz/novotree

# ── API docs ─────────────────────────────────────────────────────────────────
# Disable Swagger/ReDoc in production.
ENABLE_API_DOCS=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120

# ── JWT (REQUIRED in production) ─────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-hex-char-string

# Token lifetime in hours (default 8).  Access token is refreshed silently via
# a refresh cookie; users are only logged out when the refresh token expires.
JWT_EXPIRY_HOURS=8

# Refresh token lifetime in days (default 14).
JWT_REFRESH_DAYS=14

# ── Privacy / support contact ────────────────────────────────────────────────
# The single monitored mailbox for this deployment. Disclosed in the privacy
# policy and privacy-request responses (GDPR contact), AND shown on auth pages
# as "Having trouble? Contact the administrator". Defaults in code if unset.
# (Renamed from ADMIN_EMAIL — same mailbox, one home now. See PRIVACY_DESIGN.md §3.1.)
PRIVACY_CONTACT_EMAIL=admin@novotree.cz

# ── Deployment mode (privacy posture) ────────────────────────────────────────
# Selects which self-signups are allowed. The mode is a PRESET for the three
# flags below; set the flags explicitly only to override the preset.
# See docs/legal/PRIVACY_DESIGN.md §1 and §6.5. Defaults to "private" if unset.
#
#   private       (Mode A) — single owner = operator. No owner OR contributor
#                            signup. Share links only. This is the default and
#                            the only mode defensible without a lawyer review.
#   contributors  (Mode B) — operator stays the sole owner, but relatives can
#                            self-register as contributors to edit the tree.
#                            Requires Tier-3 §4.1 lawyer review + §4.5–§4.7.
#   public        (Mode C) — open or admin-gated owner signup (multiple owners
#                            on the server). Requires full Tier-3 (§4.1–§4.10).
#
# DO NOT move off "private" before the §4.1 lawyer review — see PRIVACY_DESIGN.md.
NOVOTREE_DEPLOYMENT_MODE=private
#
# Per-mode flag presets (uncomment a flag only to override the mode default):
#   private       → owner OFF, contributor OFF
#   contributors  → owner OFF, contributor ON
#   public        → owner ON,  contributor ON
# ALLOW_OWNER_SIGNUP=false
# ALLOW_CONTRIBUTOR_SIGNUP=false
# OWNER_SIGNUP_REQUIRES_APPROVAL=true   # only meaningful when owner signup is ON

# ── SMTP (optional) ──────────────────────────────────────────────────────────
# If not configured, contributor set-password links are shown in the UI instead
# of being emailed.  All fields must be set to enable email.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# SMTP_USER is literally "resend" for all Resend.com accounts; auth is via the API key in SMTP_PASSWORD
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
SMTP_FROM=NovoTree <noreply@contact.novotree.cz>
